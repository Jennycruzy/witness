    "renaming_a_schedule": [
      "desktop-client/src/components/schedules/",
      "loot-core/src/server/schedules/",
      "loot-core/src/shared/schedules"
    ],
    "rule_with_a_category": [
      "loot-core/src/server/rules/",
      "loot-core/src/server/transactions/transaction-rules",
      "desktop-client/src/components/rules/",
      "ManageRules",
      "RuleEditor"
    ]
  }
