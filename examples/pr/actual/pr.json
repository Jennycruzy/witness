    "label": "Actual main branch, live (edge.actualbudget.org)"
  },
  "setup": "node {base}/../../mine/actual/setup.mjs {url} {profile}",
  "tests": [
    "tests/search_filter_stays_applied_after_toggli_test.md",
    "tests/category_dropdown_menu_opens_again_after_test.md",
