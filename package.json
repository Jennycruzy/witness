{
  "name": "kane-witness",
  "version": "0.1.0",
  "description": "Kane's verdict, made safe for a coding agent to act on: WITNESS replays the same Kane recording on a second build before your agent fixes the app or the test.",
  "type": "module",
  "bin": {
    "witness": "dist/cli.js"
  },
  "files": [
    "dist",
    "evidence",
    "test/fixtures",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "witness": "node dist/cli.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "kane-cli",
    "testmu",
    "e2e",
    "coding-agent",
    "claude-code",
    "regression"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jennycruzy/witness.git"
  },
  "homepage": "https://github.com/Jennycruzy/witness"
}
